# Copy this file to .env and fill only the values required by your run mode.

# Runtime mode: mock (offline, no key required) or agno (real Agno model calls).
SHOPILOT_RUNTIME_MODE=mock

# Side effects: disabled (replay), mock (local publish), or real (reserved).
SHOPILOT_SIDE_EFFECT_MODE=mock

# OpenAI-compatible model configuration. Required when runtime mode is agno.
SHOPILOT_PROVIDER=openai
SHOPILOT_MODEL_ID=gpt-4o-mini
SHOPILOT_BASE_URL=https://api.openai.com/v1
SHOPILOT_API_KEY=

# Local persistence and runtime controls.
SHOPILOT_DATA_DIR=.shopilot
SHOPILOT_RETRY_BUDGET=2
SHOPILOT_PROVIDER_TIMEOUT=60
SHOPILOT_LOG_LEVEL=INFO
SHOPILOT_ENVIRONMENT=development

# HTTP server settings.
SHOPILOT_HOST=0.0.0.0
SHOPILOT_PORT=8000
