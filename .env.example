# ShopPilot production defaults. Copy to .env and fill the DeepSeek API Key.
SHOPILOT_RUNTIME_MODE=agno
SHOPILOT_SIDE_EFFECT_MODE=mock
SHOPILOT_PROVIDER=openai-compatible
SHOPILOT_MODEL_ID=deepseek-chat
SHOPILOT_BASE_URL=https://api.deepseek.com/v1
SHOPILOT_API_KEY=

# The local Docker stack has safe development defaults; override for production.
POSTGRES_DB=shopilot
POSTGRES_USER=shopilot
POSTGRES_PASSWORD=shopilot-local-password
MINIO_ROOT_USER=shopilot
MINIO_ROOT_PASSWORD=shopilot-local-secret
SHOPILOT_ADMIN_USERNAME=admin
SHOPILOT_ADMIN_PASSWORD=shopilot-admin
SHOPILOT_WEB_PORT=8080
MINIO_CONSOLE_PORT=9001
SHOPILOT_RETRY_BUDGET=2
SHOPILOT_PROVIDER_TIMEOUT=60
SHOPILOT_LOG_LEVEL=INFO
